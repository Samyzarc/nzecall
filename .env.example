# ----------------------------------------------------------------------
# Variables d'environnement — Nzé Call
# Copiez ce fichier vers « .env.local » pour le développement local,
# et renseignez les mêmes variables dans Vercel (Projet > Settings >
# Environment Variables) pour la production.
# ----------------------------------------------------------------------

# URL canonique du site (sans slash final).
# Utilisée pour les URL canoniques, le sitemap, robots.txt et Open Graph.
# Valeur par défaut : https://nzecall.com
SITE_URL=https://nzecall.com

# Clé API Resend (https://resend.com/api-keys), utilisée par le formulaire
# de contact pour envoyer les demandes de devis par e-mail.
# Sans cette clé en production, le formulaire affiche un message d'erreur
# générique ; en développement, l'envoi est simulé (message consigné).
RESEND_API_KEY=

# Adresse e-mail de destination des demandes de devis.
# Doit être une adresse vérifiée dans Resend si vous utilisez un domaine
# personnalisé comme expéditeur.
CONTACT_EMAIL_TO=contact@nzecall.com

# Expéditeur des e-mails (optionnel).
# Tant que le domaine nzecall.com n'est pas vérifié dans Resend, seul
# l'expéditeur de test « onboarding@resend.dev » fonctionne.
# Après vérification du domaine, par exemple :
# RESEND_FROM=Nzé Call <contact@nzecall.com>
RESEND_FROM=Nzé Call <onboarding@resend.dev>
